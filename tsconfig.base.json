{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@my-py-agents/source"
    ],
    "rootDir": ".",
    "paths": {
      "@my-py-agents/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ],
      "@my-py-agents/website": [
        "./packages/website/src/index.ts"
      ],
      "@my-py-agents/common-shadcn": [
        "./packages/common/shadcn/src/index.ts"
      ],
      "@my-py-agents/common-shadcn/*": [
        "./packages/common/shadcn/src/*"
      ],
      "@my-py-agents/strands-s3-website": [
        "./packages/strands-s3-website/src/index.ts"
      ],
      "@my-py-agents/strands-s3-infra": [
        "./packages/strands-s3-infra/src/index.ts"
      ],
      "@my-py-agents/langchain-s3-website": [
        "./packages/langchain-s3-website/src/index.ts"
      ],
      "@my-py-agents/langchain-s3-infra": [
        "./packages/langchain-s3-infra/src/index.ts"
      ],
      "@my-py-agents/langchain-dynamodb-website": [
        "./packages/langchain-dynamodb-website/src/index.ts"
      ],
      "@my-py-agents/langchain-dynamodb-infra": [
        "./packages/langchain-dynamodb-infra/src/index.ts"
      ]
    }
  }
}
