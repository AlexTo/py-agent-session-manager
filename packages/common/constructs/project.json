{
  "name": "@my-py-agents/common-constructs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/constructs/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        "my_py_agents.strands_agents:build",
        "my_py_agents.langchain_agents:build",
        "@my-py-agents/website:build",
        "my_py_agents.strands_s3_agents:build",
        "@my-py-agents/strands-s3-website:build",
        "my_py_agents.langchain_s3_agents:build",
        "@my-py-agents/langchain-s3-website:build",
        "my_py_agents.langchain_dynamodb_agents:build",
        "@my-py-agents/langchain-dynamodb-website:build"
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    }
  }
}
